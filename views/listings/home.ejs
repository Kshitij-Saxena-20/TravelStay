<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust | Find Your Next Adventure</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
        }

        .hero {
            min-height: 90vh;
            display: flex;
            align-items: center;
            padding: 60px 8%;
            color: #102a2a;
            background:
                linear-gradient(
                    90deg,
                    rgba(255, 255, 255, 0.92),
                    rgba(255, 255, 255, 0.35)
                ),
                url("https://images.unsplash.com/photo-1470770841072-f978cf4d019e?auto=format&fit=crop&w=2000&q=85")
                center/cover no-repeat;
        }

        .hero-content {
            max-width: 700px;
        }

        .brand {
            color: #087f5b;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .hero h1 {
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            font-weight: 800;
            line-height: 1.1;
            margin: 20px 0;
        }

        .hero p {
            font-size: 1.2rem;
            line-height: 1.8;
            color: #37474f;
        }

        .btn-explore {
            display: inline-block;
            margin-top: 20px;
            padding: 15px 32px;
            border-radius: 50px;
            background: #087f5b;
            color: white;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn-explore:hover {
            background: #056044;
            color: white;
            transform: translateY(-2px);
        }

        footer {
            padding: 18px;
            text-align: center;
            color: #667085;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg bg-white px-4 py-3">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-3" href="/">Wanderlust</a>

            <a class="nav-link" href="/listings">Explore Listings</a>
        </div>
    </nav>

    <main class="hero">
        <div class="hero-content">
            <div class="brand">DISCOVER · STAY · EXPLORE</div>

            <h1>Find Your Next Adventure with Wanderlust</h1>

            <p>
                Explore unique stays, from cozy cottages to mountain retreats.
                Your next getaway is just a click away!
            </p>

            <a href="/listings" class="btn-explore">
                Browse Listings &rarr;
            </a>
        </div>
    </main>

    <footer>
        &copy; <%= new Date().getFullYear() %> Wanderlust. Made for explorers.
    </footer>
</body>
</html>